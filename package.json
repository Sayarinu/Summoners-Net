{
  "name": "summonersnet",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first League of Legends esports viewer.",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "24.12.0",
    "pnpm": "11.10.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @summonersnet/web dev",
    "start": "pnpm --filter @summonersnet/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "pnpm --filter @summonersnet/ui storybook",
    "storybook:build": "pnpm --filter @summonersnet/ui storybook:build",
    "tokens:check": "node scripts/check-tokens.mjs",
    "db:migrate": "node --env-file-if-exists=.env packages/data/dist/cli.js migrate",
    "sync": "node --env-file-if-exists=.env packages/data/dist/cli.js work",
    "sync:once": "node --env-file-if-exists=.env packages/data/dist/cli.js once",
    "import": "node --env-file-if-exists=.env packages/data/dist/cli.js import",
    "backfill": "node --env-file-if-exists=.env packages/data/dist/cli.js backfill",
    "browser:test": "pnpm --filter @summonersnet/web browser:test",
    "release:test": "node --test scripts/release.test.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm tokens:check && pnpm release:test && pnpm test:coverage && pnpm build && pnpm storybook:build",
    "history:import": "node --env-file-if-exists=.env packages/data/dist/cli.js import",
    "history:import-dir": "node --env-file-if-exists=.env packages/data/dist/cli.js import-dir",
    "history:backfill-all": "node --env-file-if-exists=.env packages/data/dist/cli.js backfill-all",
    "sync:status": "node --env-file-if-exists=.env packages/data/dist/cli.js status",
    "entities:sync": "node --env-file-if-exists=.env packages/data/dist/cli.js entities",
    "entities:resolve": "node --env-file-if-exists=.env packages/data/dist/cli.js resolve",
    "entities:history": "node --env-file-if-exists=.env packages/data/dist/cli.js entity-history",
    "entities:rosters": "node --env-file-if-exists=.env packages/data/dist/cli.js entity-rosters"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.6.0",
    "prettier": "3.9.5",
    "turbo": "2.10.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
