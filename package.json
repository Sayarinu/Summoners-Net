{
  "name": "esportsviewer",
  "version": "0.0.0",
  "private": true,
  "description": "Private, local-first League of Legends esports viewer.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @esportsviewer/web dev",
    "start": "pnpm --filter @esportsviewer/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "pnpm --filter @esportsviewer/ui storybook",
    "storybook:build": "pnpm --filter @esportsviewer/ui storybook:build",
    "tokens:check": "node scripts/check-tokens.mjs",
    "db:migrate": "node --env-file-if-exists=.env packages/data/dist/cli.js migrate",
    "sync": "node --env-file-if-exists=.env packages/data/dist/cli.js work",
    "sync:once": "node --env-file-if-exists=.env packages/data/dist/cli.js once",
    "import": "node --env-file-if-exists=.env packages/data/dist/cli.js import",
    "backfill": "node --env-file-if-exists=.env packages/data/dist/cli.js backfill",
    "browser:test": "pnpm --filter @esportsviewer/web browser:test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm tokens:check && pnpm test:coverage && pnpm build && pnpm storybook:build",
    "history:import": "node --env-file-if-exists=.env packages/data/dist/cli.js import",
    "sync:status": "node --env-file-if-exists=.env packages/data/dist/cli.js status"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.6.0",
    "prettier": "3.9.5",
    "turbo": "2.10.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
