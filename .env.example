DATABASE_URL=postgresql://esportsviewer:local-esportsviewer-only@127.0.0.1:55442/esportsviewer
# Optional: separate database used exclusively by integration/browser tests.
TEST_DATABASE_URL=postgresql://esportsviewer:local-esportsviewer-only@127.0.0.1:55442/esportsviewer_test
PANDASCORE_TOKEN=
# Optional Google Cloud API key with the Drive API enabled. Downloads the official annual CSVs
# through the Drive API when anonymous Drive downloads are quota-blocked.
GOOGLE_DRIVE_API_KEY=
# Absolute path to an annual CSV. When set, the current-year refresh reads this local copy daily.
ORACLE_CURRENT_FILE=
# Optional container rehearsal settings. Keep passwords consistent on a fresh database;
# URL passwords must be percent-encoded. Changing these does not rotate an existing DB role.
POSTGRES_PASSWORD=local-esportsviewer-only
CONTAINER_DATABASE_URL=postgresql://esportsviewer:local-esportsviewer-only@postgres:5432/esportsviewer
# A file inside the shared imports volume, e.g. /app/.local/imports/2026.csv.
CONTAINER_ORACLE_CURRENT_FILE=
