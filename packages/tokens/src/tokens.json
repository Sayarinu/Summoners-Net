      "xl": { "$value": "28px" },
      "2xl": { "$value": "36px" },
      "display": { "$value": "48px" }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.1 },
      "heading": { "$value": 1.2 },
      "body": { "$value": 1.5 }
    },
    "tracking": {
      "$type": "dimension",
      "display": { "$value": "-2px" },
      "tight": { "$value": "-0.5px" },
      "normal": { "$value": "0px" },
      "wide": { "$value": "1.2px" }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "80ms" },
      "fast": { "$value": "120ms" },
      "standard": { "$value": "180ms" },
      "deliberate": { "$value": "260ms" },
      "slow": { "$value": "360ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "enter": { "$value": [0, 0, 0.2, 1] },
      "emphasized": { "$value": [0.2, 0.8, 0.2, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] }
    },
    "distance": {
      "$type": "dimension",
      "micro": { "$value": "2px" },
      "small": { "$value": "4px" },
      "medium": { "$value": "8px" }
    }
