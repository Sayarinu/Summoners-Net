      "6": { "$value": "{color.primitive.pink}" },
      "7": { "$value": "{color.primitive.amber}" },
      "8": { "$value": "{color.primitive.teal}" }
    },
    "focus": {
      "ring": { "$value": "{color.primitive.gold.300}" },
      "offset": { "$value": "{color.primitive.ink.1000}" }
    }
  },
  "space": {
