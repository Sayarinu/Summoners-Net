      "selected": { "$value": "#C8A96B1A" },
      "overlay": { "$value": "#070809CC" }
    },
    "text": {
      "primary": { "$value": "{color.primitive.white}" },
      "secondary": { "$value": "{color.primitive.silver.400}" },
      "muted": { "$value": "{color.primitive.silver.500}" },
      "disabled": { "$value": "{color.primitive.silver.600}" },
      "accent": { "$value": "{color.primitive.gold.400}" },
      "inverse": { "$value": "{color.primitive.ink.1000}" }
    },
    "border": {
