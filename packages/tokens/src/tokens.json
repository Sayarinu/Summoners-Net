    "gutterTablet": { "$value": "24px" },
    "gutterDesktop": { "$value": "32px" },
    "header": { "$value": "48px" },
    "sidebar": { "$value": "240px" },
    "inspector": { "$value": "320px" },
    "rowCompact": { "$value": "32px" },
    "row": { "$value": "40px" },
    "rowTouch": { "$value": "48px" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": "IBM Plex Sans" },
      "mono": { "$value": "IBM Plex Mono" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "size": {
      "$type": "dimension",
      "2xs": { "$value": "10px" },
      "xs": { "$value": "12px" },
