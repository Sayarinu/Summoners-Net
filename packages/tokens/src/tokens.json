{
  "$description": "Nexus Pulse dark-only design tokens. Git is the source of truth.",
  "color": {
    "$type": "color",
    "primitive": {
      "ink": {
        "1000": { "$value": "#070809" },
        "950": { "$value": "#0E1012" },
        "900": { "$value": "#16191D" },
        "800": { "$value": "#23272D" },
        "700": { "$value": "#353B44" }
      },
      "gold": {
        "500": { "$value": "#C8A96B" },
        "400": { "$value": "#D8BF8C" },
        "300": { "$value": "#E7D4AF" }
      },
      "silver": {
        "600": { "$value": "#8F969F" },
        "500": { "$value": "#AAB0B8" },
        "400": { "$value": "#C3C8CE" },
        "300": { "$value": "#D9DDE1" }
      },
      "white": { "$value": "#F4F6F8" },
      "red": { "$value": "#E06B70" },
      "green": { "$value": "#65B888" },
      "blue": { "$value": "#6EA7D9" },
      "amber": { "$value": "#D9A657" },
      "cyan": { "$value": "#63B7C9" },
      "purple": { "$value": "#9B8AD1" },
      "pink": { "$value": "#CF7E9D" },
      "teal": { "$value": "#67B6A2" },
      "transparent": { "$value": "#00000000" }
    },
    "bg": {
      "canvas": { "$value": "{color.primitive.ink.1000}" },
      "surface": { "$value": "{color.primitive.ink.950}" },
      "raised": { "$value": "{color.primitive.ink.900}" },
