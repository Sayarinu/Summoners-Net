{
  "name": "@summonersnet/ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./data-display": "./dist/data-display.js",
    "./esports": "./dist/esports.js",
    "./forms": "./dist/forms.js",
    "./internal": "./dist/internal.js",
    "./navigation": "./dist/navigation.js",
    "./primitives": "./dist/primitives.js",
    "./support": "./dist/support.js",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage storybook-static",
    "lint": "eslint .",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "storybook:build": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
